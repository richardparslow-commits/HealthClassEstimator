{
  "name": "health-class-estimator",
  "version": "2.0.0",
  "private": true,
  "description": "Life-insurance pre-underwriting and case-triage estimator \u2014 dependency-free static web app",
  "scripts": {
    "test": "node test/engine.test.js",
    "test:parity": "node test/parity.test.js",
    "test:alert": "node test/parity-alert.test.js",
    "check:consumer": "node scripts/check-consumer-parity.js",
    "check:workflows": "node scripts/check-workflow-fetches.js",
    "test:workflows": "node test/workflow-fetch.test.js",
    "test:ceiling": "node test/streamlit-ceiling.test.js",
    "test:pin": "node test/python-pin.test.js",
    "build": "node scripts/build-embedded.js",
    "release:artifact": "node scripts/build-embedded.js app_embedded.html && node scripts/write-artifact-manifest.js app_embedded.html",
    "test:manifest": "node test/manifest.test.js",
    "test:ui": "node test/ui.test.js",
    "test:build": "node test/build.test.js",
    "test:css": "node test/css.test.js",
    "test:builder": "node test/build-guard.test.js",
    "verify:streamlit-live": "python3 scripts/verify-streamlit-live.py",
    "verify:published": "bash scripts/verify-published-pair.sh",
    "test:published": "node test/published-pair.test.js",
    "verify:deployed": "node scripts/verify-streamlit-deployed.mjs",
    "test:deployed": "node test/streamlit-deployed.test.js",
    "test:deployed-alert": "node test/deployed-app-alert.test.js",
    "test:alert-step": "node test/alert-step.test.js",
    "test:publish-step": "node test/publish-step.test.js",
    "test:preflight": "node test/publish-preflight.test.js",
    "test:publish-claim": "node test/publish-claim.test.js",
    "test:condition": "node test/workflow-condition.test.js",
    "test:self-test": "node test/ci-self-test.test.js",
    "check:workflow-coverage": "node scripts/check-workflow-coverage.js",
    "test:coverage": "node test/workflow-coverage.test.js"
  }
}
